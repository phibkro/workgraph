{
  "name": "@workgraph/core",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first, evidence-bound work graph and capability roadmap.",
  "type": "module",
  "scripts": {
    "workgraph": "bun src/cli/main-bun.ts",
    "build:node": "bun build src/cli/main-node.ts --target=node --outdir=dist/node",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "format:check": "oxfmt --check .",
    "check:imports": "bun scripts/check-portable-imports.ts",
    "check": "bun scripts/check.ts",
    "accept:0001": "bun scripts/accept-0001.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.102",
    "@effect/platform-node": "4.0.0-beta.102",
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@effect/tsgo": "0.24.3",
    "@types/bun": "^1.3.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.13"
}
